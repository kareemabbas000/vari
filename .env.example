# ── Supabase (database for enquiries & newsletter) ─────────────────────────────
# Project URL (defaults to the VARI project if unset).
SUPABASE_URL=https://wdejuqvggvayxtrvkqye.supabase.co
# Secret key — server only, NEVER expose to the browser. Supabase → Project Settings → API Keys.
# Use the new secret key (sb_secret_…) or the legacy service_role key in SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
# Salt for the one-way IP hash used for spam throttling (any long random string).
IP_HASH_SALT=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
# Enables studio notifications, visitor acknowledgements and newsletter confirmations.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@vari-studio.com
# Must be on a domain verified in Resend.
CONTACT_FROM_EMAIL=VARI Studio <website@vari-studio.com>

# ── Site ───────────────────────────────────────────────────────────────────────
# Canonical site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.vari-studio.com
# "wix" serves renders from the Wix CDN; "local" serves them from /public/media.
NEXT_PUBLIC_MEDIA_SOURCE=wix
