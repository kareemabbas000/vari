# Contact form delivery (optional). Without these, the form falls back to the visitor's email client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@vari-studio.com
CONTACT_FROM_EMAIL=VARI Studio <website@vari-studio.com>

# Set to "local" after running `npm run assets:pull` to serve media from /public/media instead of the Wix CDN.
NEXT_PUBLIC_MEDIA_SOURCE=wix

# Canonical site URL used for metadata, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.vari-studio.com
